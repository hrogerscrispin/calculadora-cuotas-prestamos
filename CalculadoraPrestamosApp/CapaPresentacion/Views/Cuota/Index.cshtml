@{
	ViewData["Title"] = "Calculadora de Cuotas";

}

<div class="row justify-content-center mt-5">
	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class="card-header bg-primary text-white">
				<h5 class="mb-0">
					Calculadora de Cuotas
				</h5>
			</div>
			
			<div class="card-body">
				<form id="form-cuota">
					<div class="mb-3">
						<label class="form-label">Fecha de nacimiento</label>
						<input class="form-control" type="date" min="1900-01-01" max="@DateTime.Now.ToString("yyyy-MM-dd")" id="FechaNacimiento" />
					</div>

					<div class="mb-3">
						<label class="form-label">Monto del prestamo</label>
						<div class="input-group">
							<span class="input-group-text">
								$RD
							</span>
							<input class="form-control" type="number" id="Monto" step="0.01" min="1" placeholder="0.00"/>
						</div>
					</div>

					<div class="mb-4">
						<label class="form-label">Plazo</label>
						<select class="form-select" id="Meses">
							<option value="">--Seleccione un plazo</option>
							<option value="3">3 meses</option>
							<option value="6">6 meses</option>
							<option value="9">9 meses</option>
							<option value="12">12 meses</option>
						</select>
					</div>

					<div class="d-grid">
						<button class="btn btn-primary" type="button" onclick="calcular()">
							Calcular Cuota
						</button>
					</div>
				</form>

				<div id="resultadoCuota" class="alert alert-success mt-4" style="display:none;">
					<p class="mb-1 text-muted small">Valor de cuota mensual</p>
					<h4 class="mb-0"></h4>
				</div>

				<div id="resultadoError" class="alert alert-danger mt-4" style="display:none;"></div>

			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>

		// consumo del endpoint...
		function calcular() {
			const fechaNacimiento = document.getElementById("FechaNacimiento").value;
			const monto = document.getElementById("Monto").value;
			const meses = document.getElementById("Meses").value;

		
			if (!fechaNacimiento || !monto || !meses) {
				document.getElementById("resultadoError").style.display = "block";
				document.getElementById("resultadoError").innerText = "Todos los campos son requeridos.";
				document.getElementById("resultadoCuota").style.display = "none";
				return;
			}

			const data = {
				fechaNacimiento: fechaNacimiento,
				monto: parseFloat(monto),
				meses: parseInt(meses)
			};

			fetch('https://localhost:7092/api/Cuota/calcular', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data)
			})
			.then(response => response.json())
			.then(result => {
				if (result.valorCuota) {
					document.getElementById("resultadoCuota").style.display = "block";
					document.getElementById("resultadoCuota").querySelector("h4").innerText =
						"RD$ " + result.valorCuota.toFixed(2);
					document.getElementById("resultadoError").style.display = "none";
				} else {
					document.getElementById("resultadoError").style.display = "block";
					document.getElementById("resultadoError").innerText = result.message;
					document.getElementById("resultadoCuota").style.display = "none";
				}
			})
			.catch(error => {
				console.error(error);
				document.getElementById("resultadoError").style.display = "block";
				document.getElementById("resultadoError").innerText = "Error al conectar con la API.";
			});
		}
	</script>
}

